{
  "name": "dsh-agent-protocol",
  "version": "0.1.0",
  "description": "Portable work protocol for DSH agents: visible task line, single-pass request refinement, skill routing, forced clarification, strict mode and delivery self-check.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "dsh-agent-protocol contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BQG123/dsh-agent-protocol.git"
  },
  "homepage": "https://github.com/BQG123/dsh-agent-protocol#readme",
  "bugs": {
    "url": "https://github.com/BQG123/dsh-agent-protocol/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent",
    "protocol",
    "prompt",
    "workflow",
    "system-prompt",
    "coding-agent"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
